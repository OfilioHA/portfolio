---
import profile from '../../data/profile.json';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
---

<section id="inicio" class="relative overflow-hidden">
  <!-- Decorative dot grid (top-right) -->
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute right-6 top-24 hidden h-16 w-16 text-brand-500/30 sm:block"
    viewBox="0 0 80 80"
  >
    <defs>
      <pattern id="hero-dots" x="0" y="0" width="16" height="16" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1.4" fill="currentColor" />
      </pattern>
    </defs>
    <rect width="80" height="80" fill="url(#hero-dots)" />
  </svg>

  <Container class="relative pt-12 pb-20 sm:pt-20 sm:pb-28">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <!-- Left column -->
      <div class="reveal">
        <Eyebrow label={profile.hero.eyebrow} />

        <h1 class="mt-5 text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
          {profile.hero.headline[0]} <span class="text-brand-400">{profile.hero.headline[1]}</span>
        </h1>
        <p class="mt-3 text-2xl font-semibold text-text sm:text-3xl">
          {profile.hero.subline}
        </p>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-text-muted">
          {profile.hero.summary}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          {profile.hero.ctas.map((cta) => (
            <Button
              label={cta.label}
              href={cta.href}
              variant={cta.variant as 'primary' | 'outline'}
              arrow={cta.arrow}
              download={cta.href.endsWith('.pdf')}
            />
          ))}
        </div>

        <div class="mt-10">
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-text-faint">
            {profile.hero.techLabel}
          </p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {profile.hero.tech.map((t) => (
              <li class="rounded-md border border-white/10 bg-bg-elevated px-3 py-1.5 font-mono text-xs text-text-muted">
                {t}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Right column: visual -->
      <div class="relative mx-auto w-full max-w-md reveal">
        <!-- Hand-drawn arrow -->
        <svg
          aria-hidden="true"
          class="pointer-events-none absolute -left-8 bottom-6 hidden h-16 w-24 text-brand-500/60 md:block"
          viewBox="0 0 120 80"
          fill="none"
        >
          <path
            d="M5 10 C 30 60, 60 70, 95 35"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M88 28 L 95 35 L 86 38"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
          />
        </svg>

        <!-- Avatar with ring -->
        <div class="relative mx-auto aspect-square w-56 sm:w-64">
          <div
            class="absolute inset-0 rounded-full"
            style="background: conic-gradient(from 180deg at 50% 50%, #60a5fa 0deg, #2563eb 120deg, #1d4ed8 240deg, #60a5fa 360deg); padding: 4px;"
          >
            <div class="h-full w-full rounded-full bg-bg-base"></div>
          </div>
          <div
            class="absolute inset-[6px] grid place-items-center rounded-full text-5xl font-bold text-white"
            style="background: radial-gradient(circle at 30% 30%, #1d4ed8 0%, #0a0a14 70%);"
          >
            <span class="bg-gradient-to-br from-white via-brand-100 to-brand-400 bg-clip-text text-transparent">
              OH
            </span>
          </div>
          <!-- soft glow -->
          <div
            class="pointer-events-none absolute -inset-6 rounded-full opacity-60 blur-2xl"
            style="background: radial-gradient(circle at 50% 50%, rgba(59,130,246,0.45), transparent 60%);"
            aria-hidden="true"
          ></div>
        </div>

        <!-- Floating code card -->
        <div
          class="absolute -bottom-4 -right-2 w-[80%] rounded-xl border border-white/10 bg-bg-card/95 p-4 shadow-soft backdrop-blur sm:-right-6"
        >
          <div class="flex items-center gap-1.5 pb-2">
            <span class="size-2.5 rounded-full bg-red-400/70"></span>
            <span class="size-2.5 rounded-full bg-amber-400/70"></span>
            <span class="size-2.5 rounded-full bg-emerald-400/70"></span>
            <span class="ml-2 font-mono text-[10px] text-text-faint">~/ofilio.js</span>
          </div>
          <pre class="overflow-hidden font-mono text-[11px] leading-relaxed text-text-muted">
<code><span class="text-brand-400">const</span> <span class="text-text">developer</span> = { '{' }
  <span class="text-text">name</span>: <span class="text-emerald-300">"Ofilio"</span>,
  <span class="text-text">role</span>: <span class="text-emerald-300">"Fullstack"</span>,
  <span class="text-text">skills</span>: [<span class="text-emerald-300">"Laravel"</span>, <span class="text-emerald-300">"Vue"</span>,
    <span class="text-emerald-300">"React"</span>, <span class="text-emerald-300">"Astro"</span>],
  <span class="text-text">passion</span>: <span class="text-emerald-300">"Construir cosas
    para la web"</span>
{ '}' };</code></pre>
        </div>
      </div>
    </div>
  </Container>
</section>
